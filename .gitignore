# Environment and secrets
.env
*.env
*.env.local
config/api_keys.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.eggs/

# Data directories (host on Zenodo, ~16 GB total)
Database/
DrugTargetMetrics/
EHR_Results/
DrugResponse/
Target_Disease_Association/

# Large binary files
*.pt
*.parquet
*.zip

# Zenodo upload staging (author machine only; not used by the web server)
zenodo_upload/
figshare_upload/

# Deep-dive deliverables (generated figures + slide deck)
deep_dive_deliverables/

# Node
interactive_web_server/frontend/node_modules/

# Keep frontend build (dist/) in git for single-port deployment (avoids npm build on Render)
!interactive_web_server/frontend/dist/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local manuscript submission package (not software)
docs/Submit/
docs/Figures_Tables/
docs/nr-reporting-summary*.pdf
docs/nr-software-policy.pdf
docs/*.docx

# Author-only notes (Nature forms, internal plans) — never push
docs/_author/
docs/nr-*-ANSWERS.md
docs/GIT_AUTHORSHIP.md
docs/WEAK_TASK_REDESIGN.md
docs/feature_plan.md
docs/COMPREHENSIVE_TASK_TABLE.md

# Supplementary benchmark: retain frozen task/result evidence, not caches or logs.
benchmark/external_data/cache/
benchmark/archive/
benchmark/results/*.log

# Local Davis extract duplicate (prefer TDC cache under benchmark/external_data/cache/)
data/

# For_Reviewer: track notebooks; downloaded inputs and outputs are regenerated.
For_Reviewer/data/
For_Reviewer/static/
For_Reviewer/outputs/
For_Reviewer/.venv/
For Reviewer/

# Claude skill only (ignore other local Claude state)
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/linkd/
!.claude/skills/linkd/**
